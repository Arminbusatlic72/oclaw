NEXT_PUBLIC_SANITY_PROJECT_ID="<your project id>"  # Required
NEXT_PUBLIC_SANITY_DATASET="production"             # Required
NEXT_PUBLIC_SANITY_API_VERSION="2025-09-25"        # Optional
NEXT_PUBLIC_SANITY_STUDIO_URL="http://localhost:3333" # Optional local Studio URL
SANITY_API_READ_TOKEN="<your read token>"          # Required for authenticated reads / previews
CONTACT_FORM_WEBHOOK_URL="https://example.com/secure-contact-ingest" # Required to enable real submissions
CONTACT_FORM_WEBHOOK_TOKEN="<provider bearer token>"                # Server-only; never prefix with NEXT_PUBLIC_
CONTACT_FORM_UPLOADS_ENABLED="false"                                # Set true only when the webhook securely handles multipart documents
GOOGLE_PLACES_API_KEY="<server-only Google Places API key>"          # Optional; enables Google Reviews
GOOGLE_PLACES_PLACE_ID="<Google Place ID>"                            # Optional; required with the API key
